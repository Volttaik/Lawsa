modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Lawsa"

[[workflows.workflow]]
name = "Lawsa"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd lawsa && npm install --legacy-peer-deps && npm run dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
DATABASE_URL = "postgresql://louis:Pb_D263MMjgp0A2ATmjVxA@grand-phantom-25839.j77.aws-eu-central-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full"

[[ports]]
localPort = 3000
externalPort = 80

[nix]
channel = "stable-25_05"
